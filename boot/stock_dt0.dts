		i2c@13 {
			cell-index = <0xd>;
			compatible = "i2c-gpio";
			gpios = <0x8 0x20 0x0 0x8 0x21 0x0>;
			i2c-gpio,delay-us = <0x2>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			max77803@66 {
				compatible = "max77803,i2c";
				reg = <0x66>;
				interrupt-parent = <0x8>;
				interrupts = <0x66 0x0>;
				max77803,irq-gpio = <0x8 0x66 0x0>;
				max77803,irq-base = <0x161>;
				max77803,wc-irq-gpio = <0x0>;
				max77803,wakeup = <0x1>;
			};
		};

		i2c@19 {
			compatible = "i2c-gpio";
			gpios = <0x8 0x17 0x0 0x8 0x18 0x0>;
			i2c-gpio,sda-open-drain;
			i2c-gpio,scl-open-drain;
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			sec-fuelgauge@36 {
				compatible = "sec-fuelgauge,i2c";
				reg = <0x36>;
				fuelgauge,fuel_int = <0x8 0x4d 0x1>;
				fuelgauge,bat_int = <0x41 0x8 0x0>;
			};
		};

		samsung,vibrator {
			compatible = "vibrator";
			samsung,pmic_vib_pwm = <0x8 0x1b 0x0>;
			samsung,vib_model = <0x1>;
			samsung,pmic_vib_en = <0x0>;
			samsung,pmic_haptic_pwr_en = <0x0>;
			samsung,is_pmic_vib_pwm = <0x0>;
			samsung,pwm_period_us = <0x28>;
			samsung,duty_us = <0x24>;
			status = "ok";
		};

		i2c@21 {
			cell-index = <0x15>;
			compatible = "i2c-gpio";
			gpios = <0x8 0x5f 0x0 0x8 0x60 0x0>;

			sec_touchkey@20 {
				compatible = "melfas,melfas-tkey";
				reg = <0x20>;
				interrupt-parent = <0xf>;
				interrupts = <0x1d 0x0>;
				vdd_led-supply = <0x69>;
				vcc_en-supply = <0x10>;
				melfas,scl-gpio = <0x8 0x60 0x0>;
				melfas,sda-gpio = <0x8 0x5f 0x0>;
				melfas,irq-gpio = <0xf 0x1d 0x1>;
				melfas,tkey-keycodes = <0x8b 0x9e>;
				melfas,i2c-pull-up = <0x1>;
			};
		};

		aliases {
			spi11 = "/soc/spi@f9967000";
			spi2 = "/soc/spi@f9925000";
		};

		gpio_keys {
			compatible = "gpio-keys";
			input-name = "gpio-keys";
			vdd-supply = <0x60>;

			hold_key {
				label = "hold_key";
				gpios = <0xf 0x3 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x74>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
			};

			vol_down {
				lable = "volume_down";
				gpios = <0xf 0x2 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x72>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
			};

			vol_up {
				label = "volume_up";
				gpios = <0xf 0x5 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x73>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
			};

			net_3g {
				label = "net_3g";
				gpios = <0x8 0x40 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x221>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
			};
		};

		hall_flip {
			compatible = "hall_flip";
			interrupt-parent = <0x8>;
			interrupts = <0x2c 0x0>;
			hall,irq-gpio = <0x8 0x2c 0x0>;
		};

		det_zones {
			#list-det-cells = <0x4>;
		};

		but_zones {
			#list-but-cells = <0x3>;
		};

		regulator-tpd4s214 {
			compatible = "regulator-fixed";
			regulator-name = "usb2_otg_sw";
			gpio = <0xf 0x14 0x0>;
			parent-supply = <0x4a>;
			startup-delay-us = <0x4268>;
			enable-active-high;
		};

		hsic@f9a00000 {
			compatible = "qcom,hsic-host";
			reg = <0xf9a00000 0x400>;
			#address-cells = <0x0>;
			interrupt-parent = <0x6a>;
			interrupts = <0x0 0x1 0x2>;
			#interrupt-cells = <0x1>;
			interrupt-map-mask = <0xffffffff>;
			interrupt-map = <0x0 0x1 0x0 0x88 0x0 0x1 0x1 0x0 0x94 0x0 0x2 0x8 0x90 0x8>;
			interrupt-names = "core_irq", "async_irq", "wakeup";
			HSIC_VDDCX-supply = <0x56>;
			HSIC_GDSC-supply = <0x6b>;
			hsic,strobe-gpio = <0x8 0x90 0x0>;
			hsic,data-gpio = <0x8 0x91 0x0>;
			hsic,ignore-cal-pad-config;
			hsic,strobe-pad-offset = <0x2050>;
			hsic,data-pad-offset = <0x2054>;
			qcom,msm-bus,name = "hsic";
			qcom,msm-bus,num-cases = <0x2>;
			qcom,msm-bus,num-paths = <0x1>;
			qcom,msm-bus,vectors-KBps = <0x55 0x200 0x0 0x0 0x55 0x200 0x9c40 0x27100>;
			linux,phandle = <0x6a>;
			phandle = <0x6a>;
		};

		bluetooth_hostwake {
			compatible = "bluetooth_hostwake";
			interrupt-parent = <0x8>;
			interrupts = <0x4b 0x0>;
			bluetooth_hostwake,irq-gpio = <0x8 0x4b 0x0>;
		};

		uart@f995e000 {
			cell-index = <0x0>;
			compatible = "qcom,msm-hsuart-v14";
			status = "ok";
			reg = <0xf995e000 0x1000 0xf9944000 0x19000>;
			reg-names = "core_mem", "bam_mem";
			interrupts = <0x0 0x72 0x0 0x0 0xef 0x0>;
			interrupt-names = "core_irq", "bam_irq";
			qcom,bam-tx-ep-pipe-index = <0x2>;
			qcom,bam-rx-ep-pipe-index = <0x3>;
			qcom,msm-bus,name = "uart8";
			qcom,msm-bus,num-cases = <0x2>;
			qcom,msm-bus,num-paths = <0x1>;
			qcom,msm-bus,vectors-KBps = <0x54 0x200 0x0 0x0 0x54 0x200 0x1f4 0x320>;
		};
	};
};
